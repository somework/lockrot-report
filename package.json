{
  "name": "@somework/lockrot-report",
  "version": "0.14.0-rc.4",
  "private": true,
  "description": "The renderer behind lockrot --format=html: one self-contained page per report.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/finish-build.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:contract": "tsc -p tsconfig.contract.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "goldens": "vitest run tests/unit/goldens -u",
    "contract:fetch": "node scripts/contract.mjs fetch",
    "contract:repin": "node scripts/contract.mjs repin"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@preact/preset-vite": "2.10.6",
    "@testing-library/preact": "3.2.4",
    "@types/node": "26.6.5",
    "ajv": "8.20.0",
    "ajv-draft-04": "1.0.0",
    "eslint": "10.12.0",
    "happy-dom": "21.0.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "dependencies": {
    "preact": "10.29.8"
  }
}
